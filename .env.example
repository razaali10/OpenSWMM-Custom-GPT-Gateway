# Copy to .env and fill in for local development. Never commit the real .env.

# -- Upstream MCP server (Repository A -- not modified/imported by this repo) --
# Point this at whichever deployment owns the session pool this gateway's
# callers actually need. If uploaded-model support matters (see docs/
# ARCHITECTURE.md "Known limitation: model upload"), use the sibling
# openswmm-mcp-server deployment below -- it owns file storage/session
# creation, so a session made through its own REST upload API is then
# reachable here too. Both report the same 565-tool/24-namespace registry
# (verified 2026-09-02).
OPENSWMM_MCP_URL=https://razaali10-openswmm-mcp-server.hf.space/mcp
# Prior value, if this gateway's uploaded-model workflow isn't needed and
# a plain MCP-only server (no file storage) is preferred:
# OPENSWMM_MCP_URL=https://openswmm.onrender.com/mcp
OPENSWMM_MCP_TIMEOUT_SECONDS=30
MCP_SIMULATION_TIMEOUT_SECONDS=300
MCP_OPTIMIZATION_TIMEOUT_SECONDS=30

# -- Registry cache ------------------------------------------------------
MCP_TOOL_CACHE_TTL_SECONDS=300

# -- Networking ------------------------------------------------------------
PORT=8080

# -- Auth ------------------------------------------------------------------
# "api_key" (recommended -- this gateway exposes destructive/optimization
# tools, unlike the curated REST gateway) or "none" (local dev only).
AUTH_MODE=api_key
GATEWAY_API_KEY=

# -- CORS --------------------------------------------------------------------
ALLOWED_ORIGINS=

LOG_LEVEL=INFO
